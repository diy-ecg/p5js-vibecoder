{
  "manifest_version": 3,
  "name": "p5.js Vibe Coder (Gemini AI)",
  "version": "1.0.0",
  "description": "Vibe coding in the p5.js Web Editor with Google Gemini. Prompt your creative ideas and generate p5.js code directly.",
  "browser_specific_settings": {
    "gecko": {
      "id": "p5-vibecoder@local"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://editor.p5js.org/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://editor.p5js.org/*"
      ],
      "js": [
        "lib/ai-transformer.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/page-bridge.js"
      ],
      "matches": [
        "https://editor.p5js.org/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "p5.js Vibe Coder"
  }
}
